    "eslint-plugin-react-refresh": "^0.3.4",
    "jest": "^30.1.3",
    "jsdom": "^22.1.0",
    "ts-jest": "^29.4.2",
    "typescript": "^4.9.3",
    "vite": "^4.1.0",
    "vitest": "^0.34.6"
  },
  "jest": {
  "preset": "ts-jest",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapping": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
